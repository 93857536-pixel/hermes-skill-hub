{
  "package": {
    "identifier": "com.example.myapp",
    "version": "0.1.0",
    "longName": "My Application",
    "shortName": "MyApp"
  },
  "productName": "My Application",
  "version": "0.1.0",
  "main": "index.html",
  "distDir": "../dist",
  "window": {
    "width": 1280,
    "height": 800,
    "resizable": true,
    "fullscreen": false,
    "title": "My Application",
    "center": true,
    "theme": "Dark"
  },
  "security": {
    "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
